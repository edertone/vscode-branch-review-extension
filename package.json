{
  "name": "branch-review",
  "displayName": "Branch Review",
  "description": "Download two git branches into .branchReview/ for side-by-side review.",
  "version": "0.1.5",
  "publisher": "local-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "branchReview.open",
        "title": "Branch Review: Open Panel",
        "category": "Branch Review"
      }
    ]
  },
  "scripts": {
    "build": "npm install && npm run compile && npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
